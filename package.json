{
  "name": "@imrrd/powershell-mcp",
  "version": "0.9.1",
  "mcpName": "io.github.IMRRD/powershell-mcp",
  "publishConfig": {
    "access": "public"
  },
  "description": "A Model Context Protocol (MCP) server for Windows PowerShell - runs commands in a hidden process (no popup windows), with structured output, timeouts, and service/system management. Built for AI agents that need real Windows access.",
  "type": "module",
  "bin": {
    "powershell-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "scripts/provision-credential.ps1",
    "scripts/read-credential.ps1",
    "scripts/ProtectedCredentialStore.cs",
    "scripts/restricted-diagnostics.ps1",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-supervisors.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "supervisor:restore": "node scripts/restore-supervisor.mjs",
    "test:supervisor-compat": "node scripts/check-supervisor-compat.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "powershell",
    "windows",
    "ai-agents",
    "claude",
    "automation"
  ],
  "license": "MIT",
  "author": "IMR Research & Development (UK)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IMRRD/powershell-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ssh2": "^1.17.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ssh2": "^1.15.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@hono/node-server": "2.1.3",
    "body-parser": "2.4.0",
    "fast-uri": "4.2.3",
    "proxy-addr": "2.0.8",
    "ip-address": "10.7.4",
    "qs": "6.16.1",
    "source-map-js": "1.2.2",
    "hono": "4.13.13"
  }
}
